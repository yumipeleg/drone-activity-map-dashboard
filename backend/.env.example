# Copy this file to `.env` and adjust values as needed. `.env` itself is
# git-ignored so real/local credentials are never committed.

# Matches the default credentials in the root docker-compose.yml `db` service.
DATABASE_URL=postgresql+psycopg://drone_user:drone_password@localhost:5432/drone_activity

# Celery message broker (Redis). Used when a worker process is running locally.
CELERY_BROKER_URL=redis://localhost:6379/0

# Uncomment to override the default Angular dev-server origin allowed by CORS.
# Must be a JSON array of origin strings.
# CORS_ALLOWED_ORIGINS=["http://localhost:4200"]
